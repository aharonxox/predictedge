# PredictionEdge environment variables
# Copy this to your local .env.local and to your Vercel project env settings.

# --- Supabase (required) ---
# Create a project at https://supabase.com, then grab these values from
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# --- NVIDIA NIM (required for AI chat) ---
# This key is kept exactly as provided. Do not change, rotate, rename, or remove.
NVIDIA_API_KEY=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
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# --- Public site URL (used for password-reset redirects) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
